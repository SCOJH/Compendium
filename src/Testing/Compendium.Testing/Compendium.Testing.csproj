<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Compendium.Testing</AssemblyName>
    <RootNamespace>Compendium.Testing</RootNamespace>
    <PackageId>Compendium.Testing</PackageId>
    <MinVerTagPrefix>testing-v</MinVerTagPrefix>
    <Description>Testing utilities for Compendium Framework: TestContainers integration (PostgreSQL/Redis), test data builders (AutoFixture/Bogus), aggregate testing helpers for Event Sourcing, and the git-server contract-test kit (InMemoryGitServer + GitServerContractTests).</Description>
    <!-- The xunit metapackage (pulled for the shipped GitServerContractTests kit)
         flips IsTestProject to true, which makes `dotnet test <sln>` try to run this
         LIBRARY as a test assembly and crash the testhost. This package ships test
         utilities; it is not a test project. -->
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\Compendium.Core\Compendium.Core.csproj" />
    <ProjectReference Include="..\..\Abstractions\Compendium.Abstractions\Compendium.Abstractions.csproj" />
    <ProjectReference Include="..\..\Abstractions\Compendium.Abstractions.Git\Compendium.Abstractions.Git.csproj" />
    <ProjectReference Include="..\..\Abstractions\Compendium.Abstractions.Secrets\Compendium.Abstractions.Secrets.csproj" />
    <ProjectReference Include="..\..\Application\Compendium.Application\Compendium.Application.csproj" />
    <ProjectReference Include="..\..\Infrastructure\Compendium.Infrastructure\Compendium.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Multitenancy\Compendium.Multitenancy\Compendium.Multitenancy.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.abstractions" />
    <!-- Git contract-test kit (GitServerContractTests): [SkippableFact] per declared capability,
         AwesomeAssertions for house-style assertions in inheriting adapter test suites. -->
    <PackageReference Include="xunit" />
    <PackageReference Include="Xunit.SkippableFact" />
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Testcontainers" />
    <PackageReference Include="Bogus" />
    <PackageReference Include="AutoFixture" />
  </ItemGroup>

  <!-- NET10-01: the net9.0 target keeps the two "security overrides", and keeps
       package pruning off to be allowed to.

       Here, on the .NET 10 SDK, System.Net.Http and System.Text.RegularExpressions
       are pruned (they live in the shared framework) and a direct reference to them
       is flagged redundant (NU1510). A consumer restoring this package on the .NET 9
       SDK prunes nothing: AutoFixture 4.18.1 > Fare 2.1.1 > NETStandard.Library 1.6.1
       brings System.Net.Http 4.3.0 and System.Text.RegularExpressions 4.3.0, both
       under high-severity advisories (GHSA-7jgj-8wvc-jh57, GHSA-cmhx-cq75-c4mj), and
       a strict consumer — NuGetAuditMode=all with TreatWarningsAsErrors, which is
       agentspot-engine today — fails its restore on NU1903. The two references below
       lift that chain to the patched versions in the net9.0 nuspec group, exactly as
       before NET10-01. Pruning has to be off for that target: with it on, pack drops
       them from the nuspec, and a NoWarn on NU1510 would change nothing. The net10.0
       target needs none of this; its consumers prune.

       Remove the whole block together with net9.0, or earlier if AutoFixture 5 or
       Fare >= 2.2 stops dragging NETStandard.Library 1.6.1 in. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <RestoreEnablePackagePruning>false</RestoreEnablePackagePruning>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="System.Net.Http" />
    <PackageReference Include="System.Text.RegularExpressions" />
  </ItemGroup>

</Project>