{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Write(src/**)",
      "Edit(src/**)",
      "Write(tests/**)",
      "Edit(tests/**)",
      "Write(docs/**)",
      "Edit(docs/**)",
      "Write(samples/**)",
      "Edit(samples/**)",
      "Edit(Directory.Packages.props)",
      "Edit(Directory.Build.props)",
      "Edit(NuGet.config)",
      "Edit(Compendium.sln)",
      "Edit(samples/Samples.sln)",
      "Write(packages.lock.json)",
      "Edit(packages.lock.json)",
      "Write(**/packages.lock.json)",
      "Edit(**/packages.lock.json)",
      "Edit(**/*.csproj)",
      "Bash(dotnet build:*)",
      "Bash(dotnet test:*)",
      "Bash(dotnet restore:*)",
      "Bash(dotnet format:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git stash:*)",
      "Bash(rg:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(ls:*)",
      "Bash(wc:*)"
    ],
    "deny": [
      "Bash(terraform:*)",
      "Bash(kubectl:*)",
      "Bash(helm:*)",
      "Bash(argocd:*)",
      "Bash(scw:*)",
      "Bash(aws:*)",
      "Bash(docker push:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh secret:*)",
      "Bash(gh auth:*)",
      "Bash(gh workflow:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Edit(.github/workflows/agent-*.yml)",
      "Edit(.github/workflows/cd.yml)",
      "Edit(.github/workflows/pr-validation.yml)",
      "Read(./.env)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.kube/**)",
      "Read(~/.config/scw/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/kubeconfig*)"
    ]
  }
}
